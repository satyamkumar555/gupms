# FIREBASE MODE (Firebase Authentication + Cloud Firestore).
# Default = LOCAL EMULATORS (no cloud account needed): run `npm run emulators` first.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
AUTH_MODE=firebase
STORE=firestore
FIREBASE_PROJECT_ID=gu-pms

GOOGLE_APPLICATION_CREDENTIALS="C:\gupms\serviceAccount.json"
# REAL Firebase project: delete the two EMULATOR_HOST lines above, set FIREBASE_PROJECT_ID to your project id and add:
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\serviceAccount.json

# Optional - Firebase Storage bucket for JD PDFs / offer letters (Firebase Console > Build > Storage; Blaze plan needed).
# Leave it commented: files are then kept safely inside Firestore (works with no extra setup, max 5 MB per file).
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
