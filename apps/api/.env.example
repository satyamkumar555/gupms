# LOCAL DEVELOPER MODE (npm run dev:local): no Firebase, empty data in apps/api/.data. Real use = Firebase (.env.firebase).
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
# local = API handles email/password itself | firebase = Firebase Authentication
AUTH_MODE=local
# memory = JSON file in apps/api/.data (local) | firestore = real Firestore
STORE=memory
LOCAL_SECRET=change-this-long-random-string
# Firebase (only when AUTH_MODE=firebase / STORE=firestore)
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\serviceAccount.json
