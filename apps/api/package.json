{
  "name": "@gu-pms/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:firebase": "node ../../scripts/with-env.mjs .env.firebase -- tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev:local": "tsx watch src/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "main": "lib/src/functions.js",
  "engines": {
    "node": "20"
  }
}